# Copy to .env and adjust. Restart with `npx expo start -c` after changes.

# Django REST API base URL. Leave empty to run on built-in mock data.
EXPO_PUBLIC_API_URL=

# Force mock data even when EXPO_PUBLIC_API_URL is set.
EXPO_PUBLIC_USE_MOCKS=false

# Route natural-language queries to /search/semantic/ (backend support required).
EXPO_PUBLIC_FEATURE_SEMANTIC_SEARCH=false
